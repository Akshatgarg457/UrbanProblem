# ──────────────────────────────────────────────────────────────────────────────
# Urban Problem Reporting — Frontend Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development.
# .env.local is git-ignored — never commit real credentials.
# All VITE_ variables are embedded in the browser bundle at build time.
# Treat them as PUBLIC — do not put secrets here.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of the Spring Boot backend API (no trailing slash).
VITE_API_BASE_URL=http://localhost:8080/api

# ──────────────────────────────────────────────────────────────────────────────
# Location system — OpenStreetMap / Leaflet (no API key, no billing required)
# ──────────────────────────────────────────────────────────────────────────────
# Tile provider. Keep the official OSM tile server for production use only if
# your usage stays within the OSM tile usage policy; otherwise point these at
# your own tile server or a hosted OSM provider.
VITE_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OSM_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
VITE_OSM_WEB_BASE_URL=https://www.openstreetmap.org

# Nominatim geocoding endpoint. The public instance asks for a contact email
# and low request volume; set up your own instance for heavy traffic.
VITE_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
VITE_NOMINATIM_EMAIL=
